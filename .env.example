# Copy to .env.local and fill with your Firebase project values.
# Get these from Firebase Console -> Project settings -> General -> Your apps (Web app).
# Never add service-account / admin SDK credentials to a frontend .env file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: set a default search radius (km)
VITE_DEFAULT_RADIUS_KM=3

# Optional: Google Maps Geocoding API Key (Leaflet + OpenStreetMap works out-of-the-box if omitted)
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
